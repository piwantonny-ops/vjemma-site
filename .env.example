# VJ EMMA - Cloudflare Workers / Pages + D1 (vjemmadb) + Cloudflare R2

# Cloudflare R2 Media Upload Worker (Automatic file uploads)
VITE_R2_UPLOAD_WORKER_URL=https://vjemma-upload.piwantonny.workers.dev
VITE_R2_BUCKET=vj-emma-movies

# Optional: Public Origin URL
APP_URL=https://vjemma.site

# Optional Admin Overrides (if omitted, Admin password is saved hashed in D1 on first login
# and session signing secret is auto-generated and stored in D1)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
